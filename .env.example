# ---------------------------------------------------------------------------
# Noyb Struct — environment variables
#
# Copy to .env.local and fill in only the values you need.
# Never commit .env.local, .env.production, or any file with real secrets.
# ---------------------------------------------------------------------------

# --- Auth.js (Phase 4) -----------------------------------------------------
# Generate a secret with: pnpm exec auth secret
# AUTH_SECRET=c6104b5db97a9eeec6f80f10c623c7468f95271a58f3f6d4449ca74183c1df4b

# GitHub OAuth app — https://github.com/settings/developers
# Local callback URL: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- Database — Neon Postgres (Phase 4) ------------------------------------
# Pooled connection string — used by the application at runtime.
# DATABASE_URL=

# Direct (unpooled) connection string — used only for migrations.
# DATABASE_URL_UNPOOLED=

# --- Site URL (used in sitemap, robots, and canonical metadata) -----------
# Local development: leave unset (defaults to http://localhost:3000)
# Production: set to the deployed URL, e.g. https://design-craft.vercel.app
# NEXT_PUBLIC_SITE_URL=